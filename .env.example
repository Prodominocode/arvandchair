# -----------------------------------------------------------------------------
# دیتابیس (PostgreSQL)
# طبق تصمیم Local-First (00-tech-stack.md بخش ۱.۲): تا فاز ۱۱ فقط همین مقدار لوکال
# استفاده می‌شود؛ هیچ دیتابیس ابری (Staging) در این مرحله وصل نمی‌شود.
# لوکال: docker compose up -d   →   postgres://arvand:arvand@localhost:5432/arvandchair
# نسخه‌ی نهایی (فقط فاز ۱۱): Liara Managed Postgres
# -----------------------------------------------------------------------------
DATABASE_URI=postgres://arvand:arvand@localhost:5432/arvandchair

# -----------------------------------------------------------------------------
# Payload CMS
# با این دستور یک secret تصادفی بساز: openssl rand -base64 32
# -----------------------------------------------------------------------------
PAYLOAD_SECRET=

# آدرس عمومی سایت (برای absolute URL در ایمیل/سئو/sitemap)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# ایمیل تراکنشی — SMTP
# لوکال: Mailhog (docker compose up -d) — ایمیل واقعاً ارسال نمی‌شود، در
# http://localhost:8025 قابل مشاهده است.
# نسخه‌ی نهایی (فقط فاز ۱۱): Liara Email Server (یا SMTP اختصاصی دیگر) — همین
# متغیرها فقط با مقدار جدید پر می‌شوند، کد تغییری نمی‌کند.
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@arvandchair.local

# -----------------------------------------------------------------------------
# پرداخت
# لوکال/توسعه: PAYMENT_PROVIDER=mock (پیش‌فرض) — از lib/payment-gateway، بدون
# اتصال واقعی به هیچ درگاهی، دو دکمه‌ی «موفق/ناموفق» شبیه‌سازی می‌شود.
# Production (فاز ۶): PAYMENT_PROVIDER=zarinpal (یا هر درگاه ایرانی نهایی‌شده)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_API_KEY=

# -----------------------------------------------------------------------------
# ذخیره‌سازی مدیا
# فاز ۱ تا ۱۰: بدون نیاز — Payload از Local Disk Storage (پوشه‌ی media/) استفاده
# می‌کند، بدون هیچ S3/R2.
# نسخه‌ی نهایی (فقط فاز ۵ به بعد): Liara Object Storage (سازگار با S3 API)
# -----------------------------------------------------------------------------
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=

# -----------------------------------------------------------------------------
# جستجو (Meilisearch)
# لوکال: docker compose up -d (سرویس meilisearch، پورت ۷۷۰۰)
# -----------------------------------------------------------------------------
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=localdev-key

# -----------------------------------------------------------------------------
# مانیتورینگ خطا
# فاز ۱ تا ۱۰: بدون نیاز — فقط Console/Log لوکال
# نسخه‌ی نهایی (فقط فاز ۱۱): GlitchTip Self-hosted — همان SDK رسمی
# @sentry/nextjs بدون تغییر کد، فقط این DSN عوض می‌شود
# -----------------------------------------------------------------------------
SENTRY_DSN=
